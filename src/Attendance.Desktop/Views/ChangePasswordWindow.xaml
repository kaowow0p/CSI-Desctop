<Window x:Class="Attendance.Desktop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="14"
        Title="Смена пароля" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Смена пароля" Style="{StaticResource TitleText}" />
        <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />

        <TextBlock Text="Текущий пароль" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="CurrentBox" PasswordChanged="OnPasswordChanged" />

        <TextBlock Text="Новый пароль" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="NewBox" PasswordChanged="OnPasswordChanged" />

        <TextBlock Text="Повторите новый пароль" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="ConfirmBox" PasswordChanged="OnPasswordChanged" />

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" />
            <Button Content="Отмена" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>

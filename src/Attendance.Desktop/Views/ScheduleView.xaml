<!-- Расписание: просмотр/правка занятий группы за период и генерация занятий по шаблону недели. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Attendance.Desktop.ViewModels"
                    xmlns:local="clr-namespace:Attendance.Desktop">

    <!-- Стили берутся из App.xaml через DynamicResource: StaticResource из отдельного словаря их не видит. -->
    <local:DateOnlyConverter x:Key="DateOnly" />

    <DataTemplate DataType="{x:Type vm:ScheduleViewModel}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Расписание" Style="{DynamicResource TitleText}" Margin="0,0,0,12" />

            <!-- Фильтр: группа и период -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Группа" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding GroupId}" Width="140" AutomationProperties.Name="Группа" />
                <TextBlock Text="с" VerticalAlignment="Center" Margin="16,0,8,0" />
                <DatePicker SelectedDate="{Binding From}" Width="190" AutomationProperties.Name="Начало периода" />
                <TextBlock Text="по" VerticalAlignment="Center" Margin="8,0,8,0" />
                <DatePicker SelectedDate="{Binding To}" Width="190" AutomationProperties.Name="Конец периода" />
                <Button Content="Показать" Command="{Binding ShowCommand}" Style="{DynamicResource PrimaryButton}" Margin="16,0,0,0" />
            </WrapPanel>

            <TabControl>
                <!-- Занятия за период -->
                <TabItem Header="Занятия">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Занятия">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat='dd.MM.yyyy, ddd'}" />
                                <DataGridTextColumn Header="Пара" Binding="{Binding PairNumber}" />
                                <DataGridTextColumn Header="Дисциплина" Binding="{Binding Subject.Name}" Width="*" />
                                <DataGridTextColumn Header="Преподаватель" Binding="{Binding Teacher.FullName}" Width="*" />
                                <DataGridTextColumn Header="Часы" Binding="{Binding Hours}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Column="1" Style="{DynamicResource FormPanel}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Занятие" Style="{DynamicResource SectionTitle}" />
                                    <TextBlock Text="Дата" Style="{DynamicResource FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding Edit.Date, Converter={StaticResource DateOnly}}" AutomationProperties.Name="Дата" />
                                    <TextBlock Text="Номер пары (1–7)" Style="{DynamicResource FieldLabel}" />
                                    <TextBox Text="{Binding Edit.PairNumber}" AutomationProperties.Name="Номер пары" />
                                    <TextBlock Text="Дисциплина" Style="{DynamicResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Subjects}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding Edit.SubjectId}" AutomationProperties.Name="Дисциплина" />
                                    <TextBlock Text="Преподаватель" Style="{DynamicResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Teachers}" DisplayMemberPath="FullName" SelectedValuePath="Id"
                                              SelectedValue="{Binding Edit.TeacherId}" AutomationProperties.Name="Преподаватель" />
                                    <TextBlock Text="Часы" Style="{DynamicResource FieldLabel}" />
                                    <TextBox Text="{Binding Edit.Hours}" AutomationProperties.Name="Часы" />
                                    <TextBlock Text="{Binding ErrorMessage}" Style="{DynamicResource ErrorText}" />
                                    <ContentControl Template="{DynamicResource CrudButtons}" Focusable="False" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Генерация по шаблону недели -->
                <TabItem Header="Генерация по шаблону">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource MutedText}" Margin="0,0,0,8"
                                       Text="Шаблон недели повторяется каждую неделю периода. Заполните его вручную или возьмите первую неделю из показанного расписания." />

                            <!-- Добавление строки шаблона -->
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <ComboBox ItemsSource="{x:Static vm:ScheduleViewModel.Days}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding TemplateDay}" Width="130" Margin="0,0,8,8" AutomationProperties.Name="День недели" />
                                <TextBlock Text="пара" VerticalAlignment="Center" Margin="0,0,4,8" />
                                <TextBox Text="{Binding TemplatePair}" Width="40" Margin="0,0,8,8" AutomationProperties.Name="Номер пары" />
                                <ComboBox ItemsSource="{Binding Subjects}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          SelectedValue="{Binding TemplateSubjectId}" Width="220" Margin="0,0,8,8" AutomationProperties.Name="Дисциплина" />
                                <ComboBox ItemsSource="{Binding Teachers}" DisplayMemberPath="FullName" SelectedValuePath="Id"
                                          SelectedValue="{Binding TemplateTeacherId}" Width="220" Margin="0,0,8,8" AutomationProperties.Name="Преподаватель" />
                                <TextBlock Text="часы" VerticalAlignment="Center" Margin="0,0,4,8" />
                                <TextBox Text="{Binding TemplateHours}" Width="40" Margin="0,0,8,8" AutomationProperties.Name="Часы" />
                                <Button Content="Добавить в шаблон" Command="{Binding AddTemplateRowCommand}" Margin="0,0,8,8" />
                                <Button Content="Взять из показанной недели" Command="{Binding FillTemplateFromShownWeekCommand}" Margin="0,0,8,8" />
                            </WrapPanel>

                            <DataGrid ItemsSource="{Binding TemplateRows}" AutomationProperties.Name="Шаблон недели">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="День" Binding="{Binding DayName}" />
                                    <DataGridTextColumn Header="Пара" Binding="{Binding PairNumber}" />
                                    <DataGridTextColumn Header="Дисциплина" Binding="{Binding SubjectName}" Width="*" />
                                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="*" />
                                    <DataGridTextColumn Header="Часы" Binding="{Binding Hours}" />
                                    <DataGridTemplateColumn Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Убрать" MinWidth="0" Padding="8,2" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.RemoveTemplateRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <Border Grid.Column="1" Style="{DynamicResource FormPanel}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Создать занятия" Style="{DynamicResource SectionTitle}" />
                                <TextBlock Text="Для группы, выбранной вверху, на период:" Style="{DynamicResource MutedText}" Margin="0,4,0,0" />
                                <TextBlock Text="с" Style="{DynamicResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding GenerateFrom}" AutomationProperties.Name="Начало генерации" />
                                <TextBlock Text="по" Style="{DynamicResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding GenerateTo}" AutomationProperties.Name="Конец генерации" />
                                <TextBlock Text="Пары, которые у группы уже заняты, будут пропущены." Style="{DynamicResource MutedText}" FontSize="12" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding TemplateError}" Style="{DynamicResource ErrorText}" />
                                <TextBlock Text="{Binding TemplateStatus}" Style="{DynamicResource MutedText}" Margin="0,8,0,0" />
                                <Button Content="Создать занятия" Command="{Binding GenerateCommand}" Style="{DynamicResource PrimaryButton}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
